{
  "permissions": {
    "allow": [
      "Bash(awk *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/auth-reminder.sh"
          }
        ]
      }
    ]
  }
}
