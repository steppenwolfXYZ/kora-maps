# Local development defaults — copy to .env (scripts/routing/setup_routing.sh
# does this automatically if .env is missing). PUBLIC_* values are baked
# into the client at build time ($env/static/public).
PORT=3012
PUBLIC_ENVIRONMENT=dev
PUBLIC_MOTIS_URL=http://localhost:8080
# Valhalla base URL for the direct cycling / walking routes
# (pedestrian-bicycle-routing.md). Production uses the same-origin nginx
# proxy: PUBLIC_VALHALLA_URL=/valhalla
PUBLIC_VALHALLA_URL=http://localhost:8002

# /stats page basic auth — with either unset, the page 404s.
STATS_USER=dev
STATS_PASS=dev
# Per-site nginx access log the stats page parses (rotated .gz siblings
# are read too). Unset → /var/log/nginx/koramaps/access.log.
#STATS_ACCESS_LOG=
